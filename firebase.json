{
  "hosting": {
    "public": "admin-web/dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "/assets/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "flutter": {
    "platforms": {
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "heyteacher-3021b",
          "configurations": {
            "android": "1:854565098615:android:7ea3ff05a251acaa94a272",
            "ios": "1:854565098615:ios:4dadba23912cd69d94a272",
            "web": "1:854565098615:web:9882481ee8896eca94a272"
          }
        }
      },
      "android": {
        "default": {
          "projectId": "heyteacher-3021b",
          "appId": "1:854565098615:android:7ea3ff05a251acaa94a272",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "ios": {
        "default": {
          "projectId": "heyteacher-3021b",
          "appId": "1:854565098615:ios:4dadba23912cd69d94a272",
          "uploadDebugSymbols": false,
          "fileOutput": "ios/Runner/GoogleService-Info.plist"
        }
      }
    }
  }
}
